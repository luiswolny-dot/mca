# ===========================================================================
# Secrets and per-instance settings. Copy to .env and fill in.
# .env is gitignored — never commit it. Values here are read by both
# docker-compose.yml (container env) and config.example.yaml (${VAR} refs).
# ===========================================================================

# --- infrastructure ----------------------------------------------------------
POSTGRES_PASSWORD=changeme-generate-a-real-one
GRAFANA_PASSWORD=changeme-generate-a-real-one

# --- Solana ------------------------------------------------------------------
# A dedicated RPC node, not a public shared endpoint — public endpoints rate-
# limit exactly when the chain is busiest, which is when this system needs
# them most. Helius, QuickNode, Triton, and Alchemy all offer dedicated
# Solana endpoints; the free tiers are enough for paper trading.
SOLANA_RPC_HTTP=https://your-dedicated-rpc-endpoint.example.com
SOLANA_RPC_WS=wss://your-dedicated-rpc-endpoint.example.com
SOLANA_GEYSER=

# Public key only — never the secret key. The executor reads the encrypted
# keystore file (see security.keystore_path in config.yaml), not this.
WALLET_PUBKEY=

# Optional: paid Jupiter tier (api.jup.ag). Leave empty to use the free,
# rate-limited lite-api.jup.ag — fine for paper trading and low volume.
JUPITER_API_KEY=

COLD_WALLET=

# --- other chains (disabled by default in config.example.yaml) --------------
BASE_RPC_HTTP=
BASE_RPC_WS=
BSC_RPC_HTTP=
ETH_RPC_HTTP=

# --- data sources (only needed once ingest/enrich for them is built —
# see README.md roadmap; harmless to leave blank until then) -----------------
BIRDEYE_KEY=
COINGECKO_KEY=
CMC_KEY=
X_BEARER=
TG_API_ID=
TG_API_HASH=
REDDIT_ID=
REDDIT_SECRET=
DISCORD_TOKEN=

# --- alerts --------------------------------------------------------------
TG_BOT_TOKEN=
TG_CHAT_ID=
DISCORD_WEBHOOK=
SMTP_HOST=
ALERT_EMAIL=
NTFY_TOPIC=

OTEL_ENDPOINT=
